{
    "name": "vram-estimator",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "test": "vitest run",
        "typecheck": "tsc -b",
        "dev": "node scripts/dev.mjs",
        "dev:web": "npm run dev -w @vram-estimator/web",
        "dev:api": "npm run dev -w @vram-estimator/api",
        "cli": "npm run start -w @vram-estimator/cli"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@vitejs/plugin-react": "^4.3.4",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
